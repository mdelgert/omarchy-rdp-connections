#!/usr/bin/env bash
# RDP Connections for Omarchy — launcher.
# SPDX-License-Identifier: MIT
#
# Reads one connection from the index, its password from the Secret Service
# keyring, and hands the lot to sdl-freerdp3 over a pipe via /args-from:stdin,
# so nothing sensitive reaches the world-readable /proc/<pid>/cmdline.
# See README.md.

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=rdp-common
source "$SCRIPT_DIR/rdp-common"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="RDP Connections" "RDP Connections" "$1" || true
  else
    printf 'RDP Connections: %s\n' "$1" >&2
  fi
}

die() {
  notify "$1"
  exit 1
}

id="${1-}"
[[ -n "$id" ]] || die "No connection was selected."

for dep in jq hyprctl secret-tool sdl-freerdp3; do
  command -v "$dep" >/dev/null 2>&1 || die "Missing dependency: $dep"
done

# ------------------------------------------------------------- connection

[[ -r "$INDEX_FILE" ]] || die "No saved connections were found."

mapfile -t fields < <(jq -r --arg id "$id" \
  '.connections[] | select(.id == $id) | .server // "", .username // "", .network // ""' "$INDEX_FILE")
server="${fields[0]-}"
username="${fields[1]-}"
network="${fields[2]-}"
mapfile -t monitors < <(jq -r --arg id "$id" \
  '.connections[] | select(.id == $id) | (.monitors // [])[]' "$INDEX_FILE")

[[ -n "$server" && -n "$username" ]] || die "That connection is incomplete — check it in Edit."

password="$(secret-tool lookup application "$APP_ID" connection "$id" field password 2>/dev/null || true)"
# A locked or unavailable keyring reads as an empty value, so this covers both
# "never finished saving" and "could not unlock".
[[ -n "$password" ]] || die "No stored password, or the keyring is locked."

# /args-from: takes one argument per line, so an embedded newline would inject
# an extra argument. rdp-menu strips them on entry; this is the backstop for an
# index that was hand-edited or written by another tool.
for value in "$server" "$username" "$password"; do
  [[ "$value" != *$'\n'* ]] || die "Stored credentials contain a newline and cannot be used."
done

# ---------------------------------------------------------- hyprland socket

hypr_env || die "No running Hyprland instance was found."

# ------------------------------------------------------------------- launch

# No saved monitors means the whole desktop, which is what this plugin has
# always done. A saved list is resolved from connector names to the ids
# FreeRDP is using right now — see rdp-common for why the names are what get
# stored. A display that is not currently attached is dropped rather than
# allowed to shift every id after it onto the wrong screen.
monitor_args=()
if (( ${#monitors[@]} > 0 )); then
  mapfile -t resolved < <(resolve_monitors "${monitors[@]}")
  ids="${resolved[0]-}"
  missing="${resolved[1]-}"
  [[ -z "$missing" ]] || notify "Not attached right now: $missing"
  if [[ -z "$ids" ]]; then
    notify "None of this connection's monitors are attached — using all of them."
  elif [[ "$ids" == *,* ]]; then
    monitor_args=(/multimon "/monitors:$ids")
  else
    # One screen: /multimon would still span, so fullscreen alone targets it.
    monitor_args=("/monitors:$ids")
  fi
fi
(( ${#monitor_args[@]} > 0 )) || monitor_args=(/multimon)

# -------------------------------------------------------------------- scaling
#
# FreeRDP draws the guest at the pixel size of the surface, so on a scaled
# display Windows lands at a fraction of the size everything else on the screen
# is. /scale only takes RDP's own DesktopScaleFactor steps — 100, 140 or 180 —
# so the monitor's Hyprland scale is snapped to the nearest one, the same
# mapping omarchy-windows-vm uses. The screen that decides it is the session's
# primary: the first saved monitor, or the focused one when the connection
# spans everything.
scale_args=()
scale_percent="$(monitor_scale_percent "${monitors[0]-}")"
if (( scale_percent >= 170 )); then
  scale_args=(/scale:180)
elif (( scale_percent >= 130 )); then
  scale_args=(/scale:140)
fi

# -------------------------------------------------------------------- network
#
# Nothing stored means FreeRDP's own default, ConnectionType 7 (auto-detect):
# it measures the link during the handshake and adapts as it goes. A stored
# value pins the profile and turns the probing off instead — `lan` keeps every
# desktop effect enabled and never backs off, which is right for a host on this
# desk and wrong over a VPN. An unrecognised value is dropped rather than
# passed through, since FreeRDP aborts on an invalid /network:.
network_args=()
case "$network" in
  '' | auto) ;;
  modem | broadband | broadband-low | broadband-high | wan | lan)
    network_args=("/network:$network")
    ;;
  *) notify "Ignoring unknown network type: $network" ;;
esac

# There is deliberately no -grab-keyboard here. FreeRDP grabs the keyboard by
# default (GrabKeyboard is TRUE in `sdl-freerdp3 /list:tune`), and that grab is
# what sends SUPER and the rest to Windows. Disabling it leaves every Hyprland
# binding live over the session, so a keystroke meant for the guest can open
# the bar's Bluetooth panel or switch workspace instead. The SDL client
# implements the grab with the Wayland keyboard-shortcuts-inhibit protocol,
# which Hyprland honours; it lifts as soon as the window loses focus, and
# FreeRDP's own Ctrl+Alt+Enter still toggles fullscreen from inside the session.
args=(
  "/v:$server"
  "/u:$username"
  "/p:$password"
  /sound
  /microphone
  /clipboard
  /cert:ignore
  /dvc:rdpecam
  /gfx:AVC444:on
  # Without this the guest desktop is scaled or cropped the moment the window
  # stops being exactly the size it was at connect time.
  +dynamic-resolution
  +f
  ${network_args[@]+"${network_args[@]}"}
  ${scale_args[@]+"${scale_args[@]}"}
  "${monitor_args[@]}"
)

# printf is a shell builtin, so the credentials are written straight down the
# pipe by this process and never become another process's arguments.
printf '%s\n' "${args[@]}" | exec sdl-freerdp3 /args-from:stdin
