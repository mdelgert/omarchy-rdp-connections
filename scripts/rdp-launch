#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail

APP_ID="io.github.mdelgert.omarchy-rdp"
id="${1:?connection id is required}"
get() { secret-tool lookup application "$APP_ID" connection "$id" field "$1"; }

for command in hyprctl jq secret-tool sdl-freerdp3; do
  command -v "$command" >/dev/null || { notify-send "RDP Connections" "Missing dependency: $command"; exit 1; }
done

server="$(get server)"
username="$(get username)"
password="$(get password)"
[[ -n "$server" && -n "$username" && -n "$password" ]] || {
  notify-send "RDP Connections" "Connection is incomplete or its keyring is locked"
  exit 1
}

# Choose the newest Hyprland instance, matching the working command supplied
# by the user. WLROOTS_HACK is required by SDL FreeRDP on this setup.
hypr_env="$(hyprctl instances -j | jq -r 'sort_by(.time) | last | "HYPRLAND_INSTANCE_SIGNATURE=\(.instance) WAYLAND_DISPLAY=\(.wl_socket)"')"
[[ "$hypr_env" != "null" && -n "$hypr_env" ]] || { notify-send "RDP Connections" "No Hyprland instance found"; exit 1; }

exec env $hypr_env FREERDP_WLROOTS_HACK=force \
  sdl-freerdp3 "/v:$server" "/u:$username" "/p:$password" \
  -grab-keyboard /sound /microphone /clipboard /cert:ignore /dvc:rdpecam +f /multimon
