#!/usr/bin/env bash
# RDP Connections for Omarchy — connection manager.
# SPDX-License-Identifier: MIT
#
# The UI is Omarchy's own menu: omarchy-menu-select for pickers and
# omarchy-menu-input for text. Neither can mask input, and both return their
# answer through a temp file, so the password is never asked for that way —
# the bar widget collects it in a QML password field and passes it down this
# script's stdin. See README.md.
#
# Security model: the password lives in the Secret Service keyring and nothing
# else does. Server, username, label and monitor choice are configuration, not
# authentication material, and live in the JSON index alongside the connection
# id — see the note in rdp-common for why that line is drawn there. The index
# is owner-only, in an owner-only directory. No password is ever passed as a
# command-line argument, written to a temp file, echoed to a log, or included
# in a notification.

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=rdp-common
source "$SCRIPT_DIR/rdp-common"

# Glyphs are taken from the set Omarchy's own menu already renders, so they
# resolve in whatever Nerd Font the menu is configured with. Written as escapes
# rather than literal characters so they survive copying and editing intact.
GLYPH_CONNECT=$'\U000F14DE'  # trigger
GLYPH_NEW=$'\U000F0249'      # install
GLYPH_EDIT=$''         # setup
GLYPH_REMOVE=$'\U000F0B4C'   # remove
GLYPH_HOST=$'\U000F0379'     # monitor

# stdin is the channel back to the bar widget. Stash it on fd 3 and take
# stdin away from everything else, so no helper can swallow the answer.
# Run straight from a terminal there is no widget, so fall back to a silent
# tty read and the script stays directly testable.
INTERACTIVE=0
if [[ -t 0 ]]; then
  INTERACTIVE=1
else
  exec 3<&0 4>&1
fi
exec 0</dev/null

# ---------------------------------------------------------------- messaging

# Notifications carry a connection name at most; never a host, user or secret.
notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="RDP Connections" "RDP Connections" "$1" || true
  else
    printf 'RDP Connections: %s\n' "$1" >&2
  fi
}

die() {
  notify "$1"
  exit 1
}

for dep in jq flock secret-tool hyprctl sdl-freerdp3 omarchy-menu-select omarchy-menu-input; do
  command -v "$dep" >/dev/null 2>&1 || die "Missing dependency: $dep"
done

# -------------------------------------------------------------- index store

mkdir -p -- "$STATE_DIR"
chmod 700 -- "$STATE_DIR" 2>/dev/null || true

# One menu at a time. The bar instantiates this widget once per monitor, so
# without this guard two menus can be open side by side — and because updating
# the index means read, modify, write, the second one to save silently drops
# whatever the first one added. The lock is released when this process exits,
# including the setsid handoff in connect_connection, so it cannot go stale.
exec 9>"$STATE_DIR/.menu.lock"
if ! flock -n 9; then
  notify "A connection menu is already open."
  exit 0
fi

[[ -e "$INDEX_FILE" ]] || printf '%s\n' '{"version":2,"connections":[]}' >"$INDEX_FILE"
jq -e 'has("connections") and (.connections | type == "array")' "$INDEX_FILE" >/dev/null 2>&1 \
  || die "Connection index is unreadable: $INDEX_FILE"

# Replace the index with the JSON on stdin, but only once it has been proven
# to parse — a failed jq upstream must never truncate the user's connections.
# The temp file is created by mktemp inside the owner-only state directory
# (never /tmp) and is removed on every exit path, including a signal that lands
# between mktemp and mv. mv within one directory is atomic, so a reader either
# sees the whole old index or the whole new one.
INDEX_TMP=""
# Must end on a true status. Under `set -e` a failing EXIT trap sets the exit
# code, so without the explicit `return 0` the common case — nothing to clean,
# so the `[[ -n ... ]]` test is false — would report failure.
cleanup() {
  [[ -n "$INDEX_TMP" ]] && rm -f -- "$INDEX_TMP"
  INDEX_TMP=""
  return 0
}
trap cleanup EXIT INT TERM HUP

write_index() {
  INDEX_TMP="$(mktemp -- "$INDEX_FILE.XXXXXX")"
  if cat >"$INDEX_TMP" && jq -e . "$INDEX_TMP" >/dev/null 2>&1; then
    mv -f -- "$INDEX_TMP" "$INDEX_FILE"
    INDEX_TMP=""
  else
    cleanup
    die "Failed to update the connection index."
  fi
}

# Clear anything a previous run left behind if it was killed uncatchably.
rm -f -- "$INDEX_FILE".??????

new_id() {
  printf 'conn-%s' "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
}

conn_get() {
  jq -r --arg id "$1" --arg f "$2" \
    '.connections[] | select(.id == $id) | .[$f] // "" | tostring' "$INDEX_FILE"
}

conn_monitors() {
  jq -r --arg id "$1" \
    '.connections[] | select(.id == $id) | (.monitors // [])[]' "$INDEX_FILE"
}

# Set one string field on one connection.
conn_set() {
  jq --arg id "$1" --arg f "$2" --arg v "$3" \
    '.connections |= map(if .id == $id then .[$f] = $v else . end)' "$INDEX_FILE" | write_index
}

# Set the monitor list, which arrives as a JSON array rather than a string.
conn_set_monitors() {
  jq --arg id "$1" --argjson m "$2" \
    '.connections |= map(if .id == $id then .monitors = $m else . end)' "$INDEX_FILE" | write_index
}

# ------------------------------------------------------------------ secrets

secret_get() {
  secret-tool lookup application "$APP_ID" connection "$1" field "$2" 2>/dev/null || true
}

# The value arrives on stdin, never in argv. secret-tool requires the trailing
# newline: fed a bare value with no newline it exits 0 and stores nothing.
secret_set() {
  local id="$1" label="$2" field="$3" value="$4"
  printf '%s\n' "$value" |
    secret-tool store --label="Omarchy RDP: $label ($field)" \
      application "$APP_ID" connection "$id" field "$field" || return 1
  # secret-tool has been seen to exit 0 having created the item but committed
  # no secret, which leaves a connection that looks saved and cannot log in.
  # Read it straight back rather than trust the exit status.
  [[ "$(secret_get "$id" "$field")" == "$value" ]]
}

# server and username are cleared too, so upgrading a v1 install actually
# removes them from the keyring rather than leaving them behind unreferenced.
secret_forget() {
  local id="$1" field
  for field in server username password; do
    secret-tool clear application "$APP_ID" connection "$id" field "$field" 2>/dev/null || true
  done
}

# ------------------------------------------------------------------ migrate

# v1 kept server and username in the keyring. Move them into the index and
# clear them, once, on the first run that sees a v1 entry.
#
# A locked keyring reads as empty, and treating that as "no server" would
# quietly replace a real host with a blank one, so the whole migration backs
# out instead. Clearing only happens after the new value has been read back
# out of the index, so a crash mid-way leaves the data in one place or both,
# never neither.
migrate_index() {
  local -a legacy=()
  mapfile -t legacy < <(jq -r '.connections[] | select(has("server") | not) | .id' "$INDEX_FILE")
  (( ${#legacy[@]} > 0 )) || return 0

  local id server username
  for id in "${legacy[@]}"; do
    server="$(secret_get "$id" server)"
    if [[ -z "$server" ]]; then
      notify "Unlock the keyring to finish upgrading saved connections. Nothing was changed."
      return 0
    fi
    username="$(secret_get "$id" username)"
    jq --arg id "$id" --arg server "$server" --arg username "$username" \
      '.connections |= map(if .id == $id
                           then . + {name: (.name // ""), server: $server,
                                     username: $username, monitors: (.monitors // [])}
                           else . end)' "$INDEX_FILE" | write_index
    [[ "$(conn_get "$id" server)" == "$server" ]] || die "Could not upgrade the connection index."
    secret-tool clear application "$APP_ID" connection "$id" field server 2>/dev/null || true
    secret-tool clear application "$APP_ID" connection "$id" field username 2>/dev/null || true
  done
  jq '.version = 2' "$INDEX_FILE" | write_index
  notify "Saved connections upgraded; only passwords remain in the keyring."
}

migrate_index

# ----------------------------------------------------------------------- ui

# A connection is identified in the UI by its name, or by its server when it
# has none. Two connections may legitimately share a label, so a repeat gets a
# counter appended for display only — enough to tell the rows apart and to map
# a choice back to one id, without inventing a second name the user has to
# maintain.
#
# Fills the caller's LABELS and IDS arrays, in index order.
build_labels() {
  local id label
  declare -A seen=()
  LABELS=()
  IDS=()
  while IFS=$'\t' read -r id label; do
    [[ -n "$id" ]] || continue
    [[ -n "$label" ]] || label="(unnamed)"
    if [[ -n "${seen[$label]:-}" ]]; then
      seen["$label"]=$(( seen["$label"] + 1 ))
      label="$label (${seen[$label]})"
    else
      seen["$label"]=1
    fi
    LABELS+=("$label")
    IDS+=("$id")
  done < <(jq -r '.connections[] | [.id, (if (.name // "") != "" then .name else (.server // "") end)] | @tsv' "$INDEX_FILE")
}

label_for_id() {
  local id="$1" i
  local -a LABELS=() IDS=()
  build_labels
  for i in "${!IDS[@]}"; do
    [[ "${IDS[$i]}" == "$id" ]] && { printf '%s' "${LABELS[$i]}"; return 0; }
  done
  printf '%s' "a connection"
}

# Both helpers exit non-zero when the user presses Escape, and
# omarchy-menu-input also exits non-zero on an empty answer, so a caller only
# has to check the status to know it should stop.
pick() {
  local prompt="$1"
  shift
  omarchy-menu-select "$prompt" "$@" </dev/null
}

ask() {
  omarchy-menu-input "$1" --width 420 </dev/null
}

# Asks the bar widget for a masked password: the request goes out on fd 4 and
# the answer comes back on fd 3, so the value only ever exists in this shell's
# memory and in the widget's field.
#
# The answer is handed back in a global rather than on stdout because this has
# to run in the main shell. Inside "$( )" the request line would be captured
# by the substitution instead of reaching the widget, and the widget would
# wait for a prompt it never saw while the script waited for an answer.
SECRET_REPLY=""

ask_secret() {
  local prompt="$1" line
  SECRET_REPLY=""
  if (( INTERACTIVE )); then
    read -rsp "$prompt: " line </dev/tty
    printf '\n' >/dev/tty
    SECRET_REPLY="$line"
    return 0
  fi
  printf 'password\t%s\n' "$(sanitize "$prompt")" >&4
  IFS= read -r line <&3 || return 1
  case "$line" in
    ok:*) SECRET_REPLY="${line#ok:}" ;;
    *) return 1 ;;
  esac
}

# Newlines and tabs would corrupt the menu's option encoding, this script's
# own protocol, and the argument stream handed to FreeRDP.
sanitize() {
  local value="$1"
  printf '%s' "${value//[$'\t\r\n']/}"
}

choose_id() {
  local -a LABELS=() IDS=() options=()
  local chosen i
  build_labels
  (( ${#IDS[@]} > 0 )) || {
    notify "No saved connections yet — choose “New connection” first."
    return 1
  }
  for i in "${!LABELS[@]}"; do
    options+=("$GLYPH_HOST"$'\t'"${LABELS[$i]}")
  done
  chosen="$(pick "$1" "${options[@]}")" || return 1
  for i in "${!LABELS[@]}"; do
    [[ "${LABELS[$i]}" == "$chosen" ]] && { printf '%s' "${IDS[$i]}"; return 0; }
  done
  return 1
}

# ------------------------------------------------------------------ monitors

# Reads the caller's MONITORS array and renders it the way the prompt and the
# notifications want to say it.
monitors_summary() {
  if (( $# == 0 )); then printf 'all monitors'; else (IFS=', '; printf '%s' "$*"); fi
}

# Build an ordered monitor selection one pick at a time. Order is the whole
# point of the feature: FreeRDP takes the first id in /monitors: as the
# session's primary screen, so "DP-9 then DP-11" is a different desktop from
# "DP-11 then DP-9".
#
# Picks are stored as connector names, not the ids FreeRDP prints. Those ids
# are SDL display indices that shift when a display is plugged, unplugged or
# redocked, so a saved "3" silently becomes the wrong screen; rdp-launch
# resolves the names to whatever the ids are at connect time.
#
# An option carries its geometry as menu subtext, which comes back appended
# after a tab — so the connector name is always the field before the first
# tab, and the plain action rows below return their label alone.
edit_monitors() {
  local id="$1"
  local -a rows=() chosen=() options=()
  local row mid connector geom primary detail answer choice c already

  hypr_env || { notify "No running Hyprland instance was found."; return 0; }
  mapfile -t rows < <(monitor_rows)
  (( ${#rows[@]} > 0 )) || {
    notify "No monitors were detected — leaving this connection on all monitors."
    return 0
  }

  mapfile -t chosen < <(conn_monitors "$id")

  while true; do
    options=("$GLYPH_HOST"$'\t'"All monitors")
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r mid connector geom _ primary <<<"$row"
      already=0
      for c in ${chosen[@]+"${chosen[@]}"}; do
        [[ "$c" == "$connector" ]] && already=1
      done
      (( already )) && continue
      detail="$geom"
      (( primary )) && detail="$geom · primary"
      options+=("$GLYPH_HOST"$'\t'"$connector"$'\t'"$detail")
    done
    if (( ${#chosen[@]} > 0 )); then
      options+=("$GLYPH_CONNECT"$'\t'"Save this order")
      options+=("$GLYPH_REMOVE"$'\t'"Start over")
    fi

    answer="$(pick "Monitors: $(monitors_summary ${chosen[@]+"${chosen[@]}"})" "${options[@]}")" || return 0
    choice="${answer%%$'\t'*}"
    case "$choice" in
      'All monitors')
        conn_set_monitors "$id" '[]'
        notify "Monitors set to all."
        return 0
        ;;
      'Save this order')
        conn_set_monitors "$id" "$(printf '%s\n' "${chosen[@]}" | jq -R . | jq -sc .)"
        notify "Monitors set to $(monitors_summary "${chosen[@]}")."
        return 0
        ;;
      'Start over')
        chosen=()
        ;;
      *)
        chosen+=("$choice")
        ;;
    esac
  done
}

# ------------------------------------------------------------------- network

# FreeRDP auto-detects the link by default and adapts to it, which is the right
# answer for a connection that travels. Pinning a type turns the probing off
# and fixes the performance profile instead: worth it on a LAN, actively worse
# on anything whose bandwidth moves. Stored as the token FreeRDP expects, with
# "" meaning auto so an index written before this existed keeps working.
edit_network() {
  local id="$1" current answer choice value
  current="$(conn_get "$id" network)"
  [[ -n "$current" ]] || current="auto"
  answer="$(pick "Network (now: $current)" \
    "$GLYPH_EDIT"$'\t'"Auto"$'\t'"measure the link (default)" \
    "$GLYPH_EDIT"$'\t'"LAN"$'\t'"all effects, no probing" \
    "$GLYPH_EDIT"$'\t'"Broadband" \
    "$GLYPH_EDIT"$'\t'"WAN" \
    "$GLYPH_EDIT"$'\t'"Modem")" || return 0
  choice="${answer%%$'\t'*}"
  case "$choice" in
    Auto) value="" ;;
    LAN) value="lan" ;;
    Broadband) value="broadband" ;;
    WAN) value="wan" ;;
    Modem) value="modem" ;;
    *) return 0 ;;
  esac
  conn_set "$id" network "$value"
  notify "Network set to $choice."
}

# ------------------------------------------------------------------ actions

# Every prompt is read into `raw` first: the helpers exit non-zero when the
# user presses Escape, and that status is only visible on the assignment
# itself — wrapping the prompt in sanitize() would swallow it and turn a
# cancel into an empty string.
#
# Notifications never name the server. The user is looking at the screen when
# they act; a notification outlives the moment and can sit in a shared history.

new_connection() {
  local raw server username password id
  raw="$(ask 'Server (host or host:port)')" || return 0
  server="$(sanitize "$raw")"
  [[ -n "$server" ]] || return 0
  raw="$(ask 'Username (user or DOMAIN\user)')" || return 0
  username="$(sanitize "$raw")"
  [[ -n "$username" ]] || { notify "Username is required — nothing saved."; return 0; }

  ask_secret "Password for $server" || { notify "Cancelled — nothing saved."; return 0; }
  password="$(sanitize "$SECRET_REPLY")"
  SECRET_REPLY=""
  [[ -n "$password" ]] || { notify "Password is required — nothing saved."; return 0; }

  # Keyring first: a failure there must not leave an index entry that cannot
  # log in. A new connection spans every monitor, as it always has; the
  # monitor picker lives in Edit so the create flow stays three prompts long.
  id="$(new_id)"
  secret_set "$id" "$server" password "$password" || die "Could not write to the keyring."
  jq --arg id "$id" --arg server "$server" --arg username "$username" \
    '.connections += [{id: $id, name: "", server: $server, username: $username,
                       monitors: [], network: ""}]' \
    "$INDEX_FILE" | write_index
  notify "Connection saved."
}

# One field at a time. omarchy-menu-input cannot prefill, so the menu asks what
# to change rather than walking every field on every edit.
edit_connection() {
  local id label field raw value
  id="$(choose_id 'Edit')" || return 0

  while true; do
    label="$(label_for_id "$id")"
    field="$(pick "Edit $label" \
      "$GLYPH_EDIT	Name" \
      "$GLYPH_HOST	Server" \
      "$GLYPH_EDIT	Username" \
      "$GLYPH_EDIT	Password" \
      "$GLYPH_HOST	Monitors" \
      "$GLYPH_EDIT	Network")" || return 0

    case "$field" in
      Name)
        raw="$(ask 'Display name (blank to use the server)')" || continue
        conn_set "$id" name "$(sanitize "$raw")"
        notify "Name updated."
        ;;
      Server)
        raw="$(ask 'New server (host or host:port)')" || continue
        value="$(sanitize "$raw")"
        [[ -n "$value" ]] || continue
        conn_set "$id" server "$value"
        notify "Server updated."
        ;;
      Username)
        raw="$(ask 'New username (user or DOMAIN\user)')" || continue
        value="$(sanitize "$raw")"
        [[ -n "$value" ]] || continue
        conn_set "$id" username "$value"
        notify "Username updated."
        ;;
      Password)
        ask_secret "New password for $label" || continue
        value="$(sanitize "$SECRET_REPLY")"
        SECRET_REPLY=""
        [[ -n "$value" ]] || continue
        secret_set "$id" "$(conn_get "$id" server)" password "$value" \
          || die "Could not write to the keyring."
        notify "Password updated."
        ;;
      Monitors)
        edit_monitors "$id"
        ;;
      Network)
        edit_network "$id"
        ;;
      *) return 0 ;;
    esac
  done
}

remove_connection() {
  local id label answer
  id="$(choose_id 'Remove')" || return 0
  label="$(label_for_id "$id")"
  answer="$(pick "Remove $label?" 'Cancel' "$GLYPH_REMOVE	Remove $label")" || return 0
  [[ "$answer" == "Remove $label" ]] || return 0

  # Drop the index entry first: an entry with no keyring items is a visible,
  # repairable state, whereas orphaned keyring items are invisible.
  jq --arg id "$id" '.connections |= map(select(.id != $id))' "$INDEX_FILE" | write_index
  secret_forget "$id"
  notify "Connection removed."
}

# Detached on purpose: the RDP session has to outlive both this menu and a
# reload of the shell that spawned it.
connect_connection() {
  local id
  id="$(choose_id 'Connect')" || return 0
  # 9>&- drops the menu lock for the launched client. Without it rdp-launch
  # inherits the descriptor and holds the lock for the whole RDP session, so
  # the menu could not be reopened until the connection was closed.
  setsid --fork "$SCRIPT_DIR/rdp-launch" "$id" 9>&- </dev/null >/dev/null 2>&1
  exit 0
}

# -------------------------------------------------------------------- entry

while true; do
  action="$(pick 'RDP' \
    "$GLYPH_CONNECT	Connect" \
    "$GLYPH_NEW	New connection" \
    "$GLYPH_EDIT	Edit connection" \
    "$GLYPH_REMOVE	Remove connection")" || exit 0
  case "$action" in
    'Connect') connect_connection ;;
    'New connection') new_connection ;;
    'Edit connection') edit_connection ;;
    'Remove connection') remove_connection ;;
    *) exit 0 ;;
  esac
done
